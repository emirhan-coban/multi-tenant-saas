# Copy to .env.mail. Never commit .env.mail or share its contents.
# Enter your own Gmail address and Google's 16-character app password (without spaces).
GMAIL_ADDRESS=
GMAIL_APP_PASSWORD=
# Enable only after entering the values above.
MAIL_ENABLED=false
# test: sends ONLY to GMAIL_ADDRESS. live: sends to the selected customer address.
MAIL_DELIVERY_MODE=test

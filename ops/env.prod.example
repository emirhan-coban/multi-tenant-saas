# Faz 9 — üretim ortam değişkenleri örneği.
# Bu dosyayı .env.prod olarak kopyalayın, değerleri doldurun ve ASLA depoya işlemeyin.
#
#   cp ops/env.prod.example .env.prod
#   docker compose -f docker-compose.prod.yml --env-file .env.prod up -d --build
#
# Eksik veya zayıf bir değer varsa uygulama açılmaz (SecurityStartupCheck).

# --- Veritabanı -------------------------------------------------------------
IMAGE_TAG=2026-09-18
POSTGRES_DB=saasdb
# Şema sahibi: yalnızca Flyway göçleri ve bakım için kullanılır.
POSTGRES_USER=saas_owner
POSTGRES_PASSWORD=
# Uygulamanın kullandığı kısıtlı rol (süper kullanıcı değil, RLS'i atlayamaz).
APP_DB_USER=saas_app
APP_DB_PASSWORD=

# --- Kimlik ve oturum -------------------------------------------------------
# En az 32 bayt. Üretimde:  openssl rand -base64 48
APP_JWT_SECRET=
# Hesap e-postası kuyruğundaki kısa ömürlü bağlantıları şifreler: openssl rand -base64 32
# Bu anahtar kaybolursa bekleyen mesajlar çözülemez; yedek/kurtarma planında saklayın.
APP_ACCOUNT_MAIL_KEY=

# --- Ağ ve CORS -------------------------------------------------------------
# Ön yüz aynı kaynaktan sunulduğunda CORS'a gerek kalmaz; yine de açıkça verilmelidir.
# Joker (*) kabul edilmez ve https zorunludur.
APP_ALLOWED_ORIGINS=https://randevu.ornek.com
APP_PUBLIC_BASE_URL=https://randevu.ornek.com
VITE_API_URL=/api
WEB_PORT=8080
# HSTS: alan adı yalnızca https sunuluyorsa açın (1 yıl).
APP_HSTS_MAX_AGE_SECONDS=31536000

# --- Operasyon --------------------------------------------------------------
# /actuator/metrics bu token olmadan açılmaz:  openssl rand -hex 32
APP_OPS_METRICS_TOKEN=

# --- Web push (VAPID) -------------------------------------------------------
# Üretmek için:
#   java backend/src/main/java/com/saas/backend/push/WebPushCrypto.java
APP_PUSH_VAPID_PUBLIC_KEY=
APP_PUSH_VAPID_PRIVATE_KEY=
APP_PUSH_SUBJECT=mailto:destek@ornek.com

# --- E-posta ----------------------------------------------------------------
# Şifre sıfırlama ve doğrulama e-postaları için gereklidir.
MAIL_ENABLED=true
MAIL_DELIVERY_MODE=live
GMAIL_ADDRESS=
GMAIL_APP_PASSWORD=

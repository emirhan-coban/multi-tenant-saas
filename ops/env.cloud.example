# Supabase Free + Upstash Redis icin ornek. Gercek degerleri .env.cloud dosyasina
# koyun; .env.cloud git tarafindan yok sayilir.

# Supabase Dashboard > Connect > Session pooler (port 5432).
# TLS zorunludur. Hostu tahmin etmeyin; Connect ekranindan kopyalayin.
SUPABASE_DB_HOST=aws-0-EU-REGION.pooler.supabase.com
SUPABASE_DB_PORT=5432
SUPABASE_SSL_MODE=require
SUPABASE_PROJECT_REF=project-ref
SUPABASE_DB_NAME=postgres
SUPABASE_DB_PASSWORD=

# setup-supabase.sh bu rolu olusturur. Owner parolasi ile ayni olmamali.
APP_DB_ROLE=saas_app
APP_DB_PASSWORD=

# Spring Boot/uzak deployment degerleri. PROJECT_REF kisimlarini yukaridaki
# gercek degerle degistirin.
SPRING_DATASOURCE_URL=jdbc:postgresql://aws-0-EU-REGION.pooler.supabase.com:5432/postgres?sslmode=require
APP_DB_USER=saas_app.project-ref
DB_OWNER_USER=postgres.project-ref
DB_OWNER_PASSWORD=
SPRING_DATASOURCE_HIKARI_MAXIMUM_POOL_SIZE=5
SPRING_DATASOURCE_HIKARI_MINIMUM_IDLE=1

# Upstash Console > Redis database > Connect > TLS URL. `rediss` zorunludur.
APP_REDIS_URL=rediss://default:PASSWORD@HOST:6379

# Yalnizca yerel veriyi de tasiyacaksaniz migrate-local-data.sh kullanir.
LOCAL_DB_HOST=host.docker.internal
LOCAL_DB_PORT=5432
LOCAL_DB_NAME=saasdb
LOCAL_DB_USER=admin
LOCAL_DB_PASSWORD=

{
  // Cloudflare Workers (static assets) ile frontend yayını. Build: `npm run build` -> dist/
  // Bilinmeyen yollar index.html'e düşer (SPA yönlendirmesi: /app, /login, /book/...).
  "name": "multi-tenant-saas",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./dist",
    // /offline.html olduğu gibi servis edilir (varsayılan davranış /offline'a 307 yönlendirir; yönlendirilmiş
    // yanıt service worker'ın çevrimdışı yedeğinde gezinme isteğine verilemez).
    "html_handling": "none",
    "not_found_handling": "single-page-application"
  }
}

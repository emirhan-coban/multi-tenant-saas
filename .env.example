# Development only. Preserve an existing .env and the credentials of its database volume.
POSTGRES_DB=saasdb
POSTGRES_USER=admin
POSTGRES_PASSWORD=admin123

# Faz 8 — üretimde zorunlu (değerleri buraya değil gizli yönetimine koyun)
# java backend/src/main/java/com/saas/backend/push/WebPushCrypto.java ile üretin
APP_PUSH_VAPID_PUBLIC_KEY=
APP_PUSH_VAPID_PRIVATE_KEY=
APP_PUSH_SUBJECT=mailto:ops@example.com
APP_PUSH_ALLOW_EPHEMERAL_KEYS=true
APP_OPS_METRICS_TOKEN=
